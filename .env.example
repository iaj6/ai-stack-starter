# ── AI Stack Starter environment ───────────────────────────────────────────────
# Copy to .env.local and fill in. EVERY key is optional — the app degrades
# gracefully (in-memory vector store, hash embeddings, retrieval-only answers)
# so it always runs. Add keys to light up the real stack.

# The reasoning brain + guardrail classifier (Claude). Without it, the app
# falls back to retrieval-only answers.
ANTHROPIC_API_KEY=

# Embeddings. Voyage (recommended by Anthropic) takes priority over OpenAI.
# With neither, a local hash embedding is used (lower quality, still runs).
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Vector DB + persistence. Set either to use Postgres + pgvector instead of
# the in-memory store. Vercel Postgres provides POSTGRES_URL automatically.
# DATABASE_URL=postgres://user:pass@host:5439/app
# POSTGRES_URL=
